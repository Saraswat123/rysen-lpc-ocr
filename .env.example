# ── OCR Backend ────────────────────────────────────────────────────────────
# Options: openrouter | gemini | ollama
MODEL_BACKEND=openrouter

# ── OpenRouter (active — free vision model) ────────────────────────────────
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# ── Gemini (future — better accuracy, needs billing) ──────────────────────
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# ── Ollama (local fallback — fully offline) ───────────────────────────────
OLLAMA_MODEL=qwen2.5vl

# ── Google Sheets OAuth ────────────────────────────────────────────────────
# Path to your OAuth2 Desktop app credentials JSON
# Download from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT=/path/to/oauth_client.json

# ── Database (Docker default — change for prod) ───────────────────────────
DATABASE_URL=postgresql://lpc_user:lpc_pass@localhost:5432/lpc_db

# ── Redis (Docker default) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
