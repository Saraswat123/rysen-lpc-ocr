# ── Gemini backend (default, recommended) ─────────────────────────────────
# Free key: https://aistudio.google.com/app/apikey
# Free tier: 1,500 req/day, 1M tokens/day — zero cost for school volumes
GEMINI_API_KEY=your_key_here

# ── Switch backends ────────────────────────────────────────────────────────
# gemini = cloud, free API, PDF native, best accuracy
# ollama = local M4 Mac, fully offline, needs model pulled
MODEL_BACKEND=gemini

# ── Ollama settings (only if MODEL_BACKEND=ollama) ────────────────────────
# Install: brew install ollama && ollama pull qwen2.5vl
OLLAMA_MODEL=qwen2.5vl
